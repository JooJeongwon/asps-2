{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "asps",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "snippets",
      "database_id": "bdcf5e2d-143a-4554-90ac-4211ba2cf3c8",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "JOB_QUEUE",
        "queue": "asps-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "asps-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  }
}
